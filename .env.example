# ==============================================================================
# Nexora Digital Marketing Platform - Environment Configuration Example
# Copy this file to .env and adjust variables for your local development setup.
# Never commit real credentials or .env files to version control.
# ==============================================================================

# Core Application URLs & Ports
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5201

NEXT_PUBLIC_API_URL=http://localhost:5201
VITE_API_URL=http://localhost:5201

# SQL Server Connection Strings
# LocalDB: Server=(localdb)\MSSQLLocalDB;Database=nexora_dev;Trusted_Connection=True;TrustServerCertificate=True
# Standard / Express: Server=localhost;Database=nexora_dev;User Id=your_user;Password=your_password;TrustServerCertificate=True
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=nexora_dev;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__TestConnection=Server=(localdb)\MSSQLLocalDB;Database=nexora_test;Trusted_Connection=True;TrustServerCertificate=True

# Initial Admin Seeding (Mandatory in Production if no Owner exists, Optional with warning in Dev)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=YourStrongPasswordHere!

# Authentication & Cookie Configuration
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=false

# CORS Allowed Origins
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

# SMTP & Mailpit Settings (Local Mailpit runs on port 1025)
Smtp__Host=localhost
Smtp__Port=1025
Smtp__UseSsl=false
Smtp__UserName=
Smtp__Password=
Smtp__FromEmail=noreply@nexora.local
Smtp__FromName=Nexora Platform

# Multi-Country Configuration
NEXT_PUBLIC_REGION_COOKIE_NAME=nexora_region
NEXT_PUBLIC_DEFAULT_REGION=IN
NEXT_PUBLIC_URL_STRATEGY=cookie
