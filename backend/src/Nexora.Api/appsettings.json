{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Region": {
    "DefaultRegionCode": "IN",
    "DefaultCulture": "en-IN",
    "DefaultTimeZoneId": "Asia/Kolkata",
    "SupportedRegions": {
      "IN": {
        "Code": "IN",
        "Culture": "en-IN",
        "TimeZoneId": "Asia/Kolkata"
      },
      "US": {
        "Code": "US",
        "Culture": "en-US",
        "TimeZoneId": "America/New_York"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Email": {
    "Provider": "Smtp"
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": "Nexora Platform"
  },
  "Storage": {
    "Provider": "Local",
    "Cloud": {
      "EndpointUrl": "",
      "PublicBaseUrl": "",
      "BearerToken": "",
      "SasToken": ""
    }
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "Search": {
    "Provider": "Sql",
    "EndpointUrl": "",
    "ApiKey": ""
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromEmail": "noreply@nexora.local",
    "FromName": "Nexora Platform"
  },
  "PasswordPolicy": {
    "RequiredLength": 12,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireNonAlphanumeric": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174"
    ]
  },
  "AuthCookie": {
    "CookieName": ".Nexora.Session",
    "Domain": null,
    "SameSite": "Lax",
    "Secure": false,
    "ExpireMinutes": 480
  },
  "Platform": {
    "CompanyName": "Platform Company",
    "LegalName": "Platform Legal Entity Ltd.",
    "SupportEmail": "support@example.com",
    "SupportPhone": "+00-000-0000000",
    "Address": "Headquarters Address Placeholder",
    "TimeZoneId": "UTC"
  },
  "SpamProtection": {
    "MinSubmissionSeconds": 3,
    "MaxSubmissionSeconds": 86400,
    "TurnstileVerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
    "AllowedHostnames": ["localhost", "127.0.0.1", "nexora.local"]
  }
}
