{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Region": {
    "DefaultRegionCode": "IN",
    "DefaultCulture": "en-IN",
    "DefaultTimeZoneId": "Asia/Kolkata",
    "SupportedRegions": {
      "IN": {
        "Code": "IN",
        "Culture": "en-IN",
        "TimeZoneId": "Asia/Kolkata"
      },
      "US": {
        "Code": "US",
        "Culture": "en-US",
        "TimeZoneId": "America/New_York"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromEmail": "noreply@nexora.local",
    "FromName": "Nexora Platform"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173"]
  },
  "AuthCookie": {
    "CookieName": ".Nexora.Admin.Session",
    "Domain": null,
    "SameSite": "Lax",
    "Secure": false,
    "ExpireMinutes": 480
  }
}
